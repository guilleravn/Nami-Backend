# App
NODE_ENV=development
PORT=3000
# Comma-separated allowed origins. Empty disables CORS. Required in production.
CORS_ORIGIN=http://localhost:5173

# Postgres container (docker-compose.yml)
POSTGRES_USER=nami
POSTGRES_PASSWORD=nami
POSTGRES_DB=nami
DB_PORT=5433

# Prisma: the app database
DATABASE_URL=postgresql://nami:nami@localhost:5433/nami

# e2e tests: same server, separate database. Must differ from DATABASE_URL.
DATABASE_URL_TEST=postgresql://nami:nami@localhost:5433/nami_test
